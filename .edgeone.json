{
  "version": 3,
  "routes": [
    {
      "src": "/albums/(.*?)",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/admin.html",
      "dest": "/admin.html"
    },
    {
      "src": "/1.html",
      "dest": "/1.html"
    },
    {
      "src": "/*",
      "dest": "/index.html"
    }
  ]
}
